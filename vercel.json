    { "source": "/eventos/pesquisa-experiencia.html", "destination": "/f/?f=pesquisa_experiencia", "permanent": false },
    { "source": "/pesquisa-experiencia.html", "destination": "/f/?f=pesquisa_experiencia", "permanent": false },
    { "source": "/eventos/questionario.html", "destination": "/f/?f=questionario", "permanent": false },
    { "source": "/questionario.html", "destination": "/f/?f=questionario", "permanent": false },

    { "source": "/ferramentas/pdi.html", "destination": "/f/?f=pdi", "permanent": false },
    { "source": "/pdi.html", "destination": "/f/?f=pdi", "permanent": false },
