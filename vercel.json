    { "source": "/programa/questionarios-rhcp.html", "has": [{ "type": "query", "key": "tipo", "value": "(?<tipo>direcao|gestores|colaboradores)" }], "destination": "/f/?f=rhcp_:tipo", "permanent": false },
    { "source": "/questionarios-rhcp.html", "has": [{ "type": "query", "key": "tipo", "value": "(?<tipo>direcao|gestores|colaboradores)" }], "destination": "/f/?f=rhcp_:tipo", "permanent": false },
    { "source": "/programa/questionarios-rhcp.html", "destination": "/f/?f=rhcp_direcao", "permanent": false },
    { "source": "/questionarios-rhcp.html", "destination": "/f/?f=rhcp_direcao", "permanent": false },
    { "source": "/programa/identidade.html", "destination": "/f/?f=identidade", "permanent": false },
    { "source": "/programa/cartilha.html", "destination": "/f/?f=cartilha", "permanent": false },
    { "source": "/programa/pre-diagnostico.html", "destination": "/f/?f=pre_diagnostico", "permanent": false },
    { "source": "/pre-diagnostico.html", "destination": "/f/?f=pre_diagnostico", "permanent": false },
    { "source": "/programa", "destination": "/", "permanent": false },
    { "source": "/programa/:rest*", "destination": "/", "permanent": false },
    { "source": "/diagnostico.html", "destination": "/", "permanent": false },
    { "source": "/Diagnostico_Organizacional_RH.html", "destination": "/", "permanent": false },

    { "source": "/eventos/confirmacao.html", "destination": "/f/?f=confirmacao_evento", "permanent": false },
