    { "source": "/ferramentas/apostila.html", "destination": "/materiais/apostila.html", "permanent": false },
    { "source": "/apostila.html", "destination": "/materiais/apostila.html", "permanent": false },
    { "source": "/apresentacoes/lideres.html", "destination": "/materiais/lideres.html", "permanent": false },
