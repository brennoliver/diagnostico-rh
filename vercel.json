    { "source": "/confirmacao.html", "destination": "/eventos/confirmacao.html", "permanent": false },
    { "source": "/pre-palestra-executivo.html", "destination": "/eventos/pre-palestra-executivo.html", "permanent": false },
    { "source": "/pesquisa-experiencia.html", "destination": "/eventos/pesquisa-experiencia.html", "permanent": false },
    { "source": "/questionario.html", "destination": "/eventos/questionario.html", "permanent": false },
    { "source": "/pdi.html", "destination": "/ferramentas/pdi.html", "permanent": false },
    { "source": "/recrutamento.html", "destination": "/ferramentas/recrutamento.html", "permanent": false },
    { "source": "/apostila.html", "destination": "/ferramentas/apostila.html", "permanent": false },
    { "source": "/lideres.html", "destination": "/apresentacoes/lideres.html", "permanent": false },
    { "source": "/lideres-slides.html", "destination": "/apresentacoes/lideres-slides.html", "permanent": false },
